DEEPSEEK_API_KEY=вставьте_сюда_свой_ключ
DEEPSEEK_MODEL=deepseek-v4-flash
# Необязательно, только для отдельного OpenAQ MCP (бесплатный ключ openaq.org).
OPENAQ_API_KEY=
# Необязательно: OpenAlex работает без ключа, ключ повышает лимиты API.
OPENALEX_API_KEY=
# Необязательно: DEBUG, INFO, WARNING или ERROR. По умолчанию INFO.
DEEPSEEK_LOG_LEVEL=INFO
